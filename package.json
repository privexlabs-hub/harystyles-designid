{
  "name": "harystyles-design",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "assets": "node scripts/fetch-fonts.mjs && node scripts/generate-brand-assets.mjs && node scripts/generate-textures.mjs && node scripts/copy-wasm.mjs",
    "assets:fonts": "node scripts/fetch-fonts.mjs",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "lint:satori": "node --import ./scripts/lib/register-ts.mjs scripts/lint-satori.mjs",
    "visreg": "node --import ./scripts/lib/register-ts.mjs scripts/visreg.mjs",
    "check:all": "npm run check:tokens && tsc --noEmit && npm run lint:satori && npm run visreg",
    "serve:out": "npx --yes http-server out -p 3010 -s",
    "verify:export": "node scripts/verify-export.mjs",
    "verify:batch": "node scripts/verify-batch.mjs",
    "verify:responsive": "node scripts/responsive-check.mjs",
    "verify:a11y": "node --import ./scripts/lib/register-ts.mjs scripts/verify-a11y.mjs",
    "verify": "npm run verify:export && npm run verify:batch && npm run verify:responsive && npm run verify:a11y"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "client-zip": "^2.5.0",
    "jspdf": "^4.2.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "satori": "^0.29.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5"
  }
}
